# Copy to web/.env.local only when the API runs on another computer, then restart `npm run dev:web`.
# Local network (the backend Mac's IP is in System Settings → Wi-Fi → Details):
# API_PROXY_TARGET=http://192.168.1.50:3001
# Through ngrok (when the network blocks connections between computers):
# API_PROXY_TARGET=https://something.ngrok-free.app
