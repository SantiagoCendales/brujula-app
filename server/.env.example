PORT=3001
DATABASE_URL=postgres://brujula:brujula@localhost:5433/brujula

# Random string of 32+ characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

UPLOADS_DIR=uploads

# Origins allowed to call the API from another origin (the Android/iOS apps). Default:
# CORS_ORIGINS=https://localhost,capacitor://localhost

# Password for the demo users created by `npm run db:seed` (default: brujula123)
# SEED_PASSWORD=

# Production: true if the managed database requires SSL
# DATABASE_SSL=true
