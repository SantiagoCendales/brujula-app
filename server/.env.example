PORT=3001
DATABASE_URL=postgres://brujula:brujula@localhost:5433/brujula

# Random string of 32+ characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

UPLOADS_DIR=uploads

# Where photos are stored: "local" (the UPLOADS_DIR folder, default) or "s3" (any S3-compatible private bucket,
# for example Supabase Storage or Cloudflare R2). Hosting platforms can wipe the local disk, so production needs "s3".
# STORAGE_DRIVER=s3
# Supabase: copy the endpoint and region from Storage > S3 and keep the bucket private.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=<project-region>
# S3_FORCE_PATH_STYLE=true

# Origins allowed to call the API from another origin (the Android/iOS apps). Default:
# CORS_ORIGINS=https://localhost,capacitor://localhost

# Password for the demo users created by `npm run db:seed` (default: brujula123)
# SEED_PASSWORD=

# Production: true if the managed database requires SSL
# DATABASE_SSL=true
# Only for a private CA (the PEM text); public providers do not need it
# DATABASE_SSL_CA=

# First real admin for production: ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD (12+ characters)
# are read by `npm run create-admin -w server`. Pass them in the shell, do not save the password here.
